# Copy to .env and fill in. .env is gitignored -- never commit real credentials.
#
# NONE OF THIS IS REQUIRED for normal use. Just run:
#
#     migratify login
#
# The settings below exist only for the fallback auth flows and for tuning.

# --- Spotify, fallback PKCE flow only --------------------------------------
# Needed ONLY for `migratify auth spotify --pkce`.
#
# Note: since 2025 Spotify requires a Premium subscription to enable Web API
# access on a new app, which is exactly why this is the fallback and not the
# default path. `migratify login spotify` needs none of this.
#
# Create an app at https://developer.spotify.com/dashboard and add this exact
# redirect URI to it. PKCE is used, so there is NO client secret.
MIGRATIFY_SPOTIFY_CLIENT_ID=
MIGRATIFY_SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# --- YouTube Music, fallback OAuth flow only -------------------------------
# Needed ONLY for `migratify auth ytmusic --oauth`.
# Google Cloud console > Credentials > OAuth client ID > "TV and Limited Input"
MIGRATIFY_YTM_CLIENT_ID=
MIGRATIFY_YTM_CLIENT_SECRET=

# --- Matching thresholds ----------------------------------------------------
# Raise AUTO_ACCEPT to be stricter (more review, fewer wrong tracks).
# Lower REVIEW_FLOOR to surface more candidates instead of reporting a miss.
# Raise AMBIGUITY_MARGIN to send more near-ties to review.
# MIGRATIFY_AUTO_ACCEPT=88
# MIGRATIFY_REVIEW_FLOOR=70
# MIGRATIFY_AMBIGUITY_MARGIN=4

# --- Where Migratify keeps its data (default: ~/.migratify) -----------------
# MIGRATIFY_HOME=
