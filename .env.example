# Copy to .env and fill in. .env is gitignored -- never commit real credentials.

# --- Spotify ---------------------------------------------------------------
# Create an app at https://developer.spotify.com/dashboard
# Add this exact redirect URI to the app: http://127.0.0.1:8888/callback
# PKCE is used, so NO client secret is required.
MIGRATIFY_SPOTIFY_CLIENT_ID=
MIGRATIFY_SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# --- YouTube Music (only for --oauth; --browser needs none of this) --------
# Google Cloud console > Credentials > OAuth client ID > "TV and Limited Input"
MIGRATIFY_YTM_CLIENT_ID=
MIGRATIFY_YTM_CLIENT_SECRET=

# --- Optional tuning -------------------------------------------------------
# MIGRATIFY_AUTO_ACCEPT=88
# MIGRATIFY_REVIEW_FLOOR=70
# MIGRATIFY_HOME=
